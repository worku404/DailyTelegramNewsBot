# Copy this file to ".env" for LOCAL TESTING ONLY.
# Never commit the real ".env" file to git — it is already listed in .gitignore.
# In production (GitHub Actions), these values come from repo Secrets/Variables instead.

API1_KEY=your_first_gemini_api_key_here
API2_KEY=your_second_gemini_api_key_here
API3_KEY=your_third_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.5-flash

HF_IMAGE_TOKEN_1=your_first_huggingface_token_here
HF_IMAGE_TOKEN_2=your_second_huggingface_token_here
HF_IMAGE_TOKEN_3=your_third_huggingface_token_here

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=-1001234567890