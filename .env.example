# Copy this file to ".env" for LOCAL TESTING ONLY.
# Never commit the real ".env" file to git — it is already listed in .gitignore.
# In production (GitHub Actions), these values come from repo Secrets/Variables instead —
# see README.md -> "Where to store your secrets".

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.5-flash
HF_IMAGE_TOKEN=your_huggingface_token_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=-1001234567890